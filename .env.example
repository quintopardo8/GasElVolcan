# Copia este archivo como .env (no se sube a git).

# Dónde está el backend (sin "/" al final).
# Local, con el backend en la misma PC:
USUARIOS_API=http://host.docker.internal:8081
PEDIDOS_API=http://host.docker.internal:8082
# AWS: IP privada de la EC2 del backend, por ejemplo:
# USUARIOS_API=http://172.31.20.15:8081
# PEDIDOS_API=http://172.31.20.15:8082

# Puerto donde se publica la tienda (en AWS usa 80)
FRONTEND_PORT=8080
