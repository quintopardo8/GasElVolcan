# Copia este archivo como .env (junto a docker-compose.yml de la raíz). El .env NO se sube a git.

# Contraseña del usuario 'volcan' de PostgreSQL
DB_PASSWORD=volcan123

# Secreto para firmar los JWT: mínimo 32 caracteres. Genera uno con:  openssl rand -base64 48
JWT_SECRET=desarrollo-cambia-este-secreto-por-uno-largo-y-aleatorio

# Minutos de validez del token (para la demo de expiración puedes bajarlo a 2)
JWT_MINUTOS=480

# Administrador que se crea al primer arranque
ADMIN_CORREO=admin@elvolcan.cl
ADMIN_CONTRASENA=Admin1234

# true = crea operadora, 3 repartidores y 1 cliente de prueba la primera vez
DATOS_DEMO=true

# Orígenes que pueden llamar directo a la API desde el navegador
CORS_ORIGENES=http://localhost:5173,http://localhost:8080

# Memoria de cada microservicio (JVM)
JAVA_OPTS=-Xms128m -Xmx384m

# Puertos en tu PC
FRONTEND_PORT=8080
POSTGRES_PORT=5433
